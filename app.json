{
  "expo": {
    "name": "Anjuroela Fit",
    "slug": "anjuroela-fit",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anjuroela.fit",
      "buildNumber": "1",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Anjuroela Fit sincroniza tu ritmo cardíaco y las calorías quemadas con tu reloj, pulsera o anillo inteligente (HealthKit) para registrarlas automáticamente en tu progreso.",
        "NSHealthUpdateUsageDescription": "Anjuroela Fit guarda el ritmo cardíaco y las calorías que el wearable reporta durante tus entrenamientos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.anjuroela.fit",
      "versionCode": 6,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-notifications",
      "expo-font",
      "expo-asset",
      "expo-sqlite",
      "expo-secure-store",
      "expo-updates",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1a1a2e"
        }
      ],
      "expo-audio",
      "react-native-health",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "scheme": "anjuroela-fit",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "9e5836b5-5a45-4619-a2fe-222ba8f8cdaf"
      }
    }
  }
}
